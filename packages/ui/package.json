{
  "name": "@bordfodbold/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The djui components this app uses, copied and owned, with the Bordfodbold theme.",
  "exports": {
    ".": "./src/index.ts",
    "./scripts": "./src/scripts/index.ts",
    "./config": "./src/config/index.ts",
    "./themes/*": "./src/themes/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "theme:generate": "tsx scripts/generate-theme.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@zag-js/dialog": "^1.41.2",
    "@zag-js/i18n-utils": "^1.41.2",
    "@zag-js/number-input": "^1.41.2",
    "@zag-js/pin-input": "^1.41.2",
    "@zag-js/react": "^1.41.2",
    "@zag-js/switch": "^1.41.2",
    "@zag-js/tabs": "^1.41.2",
    "use-bem": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.90.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
